# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See plan section 5a for the "single shared .env" rationale.

LOG_LEVEL=info

# Single toggle: swap "fireworks" -> "amd_cloud" -> "ollama" and every agent's
# LiteLLM calls reroute, no code changes. Flip to amd_cloud once credits land
# to prove real AMD platform usage for judging.
LLM_PROVIDER=fireworks

FIREWORKS_API_KEY=
AMD_DEVELOPER_CLOUD_API_KEY=
AMD_DEVELOPER_CLOUD_API_BASE=

# ASR — see plan section 5b. LocalAgreement over SimulStreaming (stability),
# "whisper" backend over default "faster-whisper" (no ROCm support in CTranslate2).
ASR_POLICY=localagreement
ASR_BACKEND=whisper

# Stream Judge batching — see plan section 6.
BATCH_STRATEGY=vad_pause

REDIS_URL=redis://redis:6379

# Fill in after `docker compose up` — LiteLLM proxy's own key if you set one
LITELLM_MASTER_KEY=


COMPOSE_BAKE=false